        '2026-11-02': timestamp.date(2026, 11, 2) + duration.value(21600, 's')}; }
    function clamp(v, max) { return v < 0 ? 0 : (v > max ? max : v); }
    function computedPlayerBounds(p) {
      return p.groom.hp[0] is int && p.groom.hp[1] is int && p.groom.hp[1] > 0 && p.groom.hp[1] <= 10000
        && p.groom.mp[0] is int && p.groom.mp[1] is int && p.groom.mp[1] > 0 && p.groom.mp[1] <= 10000
        && p.groom.hunger[0] is int && p.groom.hunger[1] is int && p.groom.hunger[1] > 0 && p.groom.hunger[1] <= 10000
        && p.groom.joy[0] is int && p.groom.joy[1] is int && p.groom.joy[1] > 0 && p.groom.joy[1] <= 10000
        && p.bride.hp[0] is int && p.bride.hp[1] is int && p.bride.hp[1] > 0 && p.bride.hp[1] <= 10000
        && p.bride.mp[0] is int && p.bride.mp[1] is int && p.bride.mp[1] > 0 && p.bride.mp[1] <= 10000
        && p.bride.hunger[0] is int && p.bride.hunger[1] is int && p.bride.hunger[1] > 0 && p.bride.hunger[1] <= 10000
        && p.bride.joy[0] is int && p.bride.joy[1] is int && p.bride.joy[1] > 0 && p.bride.joy[1] <= 10000;
    }
    function validEvent(before, after, op) {
      return op.keys().hasOnly(['kind','id','actor']) && op.id is string && op.id in ["d1-rest","d1-meal","d1-bath","d1-sleep","d2-view","d2-snack","d2-rest","d2-meal","d2-bath","d2-sleep","d3-meal","d3-rest"]
        && !(op.id in before.done)
        && after.done == before.done.concat([op.id]) && after.questClears == before.questClears && after.logs == before.logs
