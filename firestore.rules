// Generated by npm run rules:generate. Deploy only after reviewing both UIDs.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function groomUID() { return ""; }
    function brideUID() { return ""; }
    function allowed() {
      return request.auth != null && groomUID() != '' && brideUID() != '' && groomUID() != brideUID()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.uid in [groomUID(), brideUID()];
    }
    function owner() { return request.auth.uid == groomUID() ? 'groom' : 'bride'; }
    function other() { return owner() == 'groom' ? 'bride' : 'groom'; }
    function pair(p) {
      return p is list && p.size() == 2 && p[0] is int && p[1] is int
        && p[1] > 0 && p[1] <= 10000 && p[0] >= 0 && p[0] <= p[1];
    }
    function player(p) {
      return p is map && p.keys().hasAll(['hp','mp','hunger','joy']) && p.keys().hasOnly(['hp','mp','hunger','joy'])
        && pair(p.hp) && pair(p.mp) && pair(p.hunger) && pair(p.joy);
    }
    // Each operation validates player values once: exact init/reward, unchanged quest, or owner-only status.
    function envelope(d) {
      return d.keys().hasAll(['schemaVersion','players','done','questClears','logs','revision','lastOperation','updatedAt'])
        && d.keys().hasOnly(['schemaVersion','players','done','questClears','logs','revision','lastOperation','updatedAt'])
        && d.schemaVersion == 1 && d.revision is int && d.revision >= 0 && d.revision <= 100000
        && d.players is map && d.players.keys().hasAll(['groom','bride']) && d.players.keys().hasOnly(['groom','bride'])
        && d.done is list && d.done.size() <= 12
        && d.questClears is map && d.questClears.size() <= 10
        && d.logs is map && d.logs.size() <= 6
        && d.lastOperation is map && d.lastOperation.actor == request.auth.uid && d.updatedAt == request.time;
    }
    function eventReward(id) {
      // Lazy selection: build only the requested effect, not the entire trip table.
      return id == 'd1-rest' ? {'at': timestamp.date(2026, 10, 31) + duration.value(28800, 's'), 'max': {"hp":25,"mp":25}, 'current': {"hp":20,"mp":50}} :
        id == 'd1-meal' ? {'at': timestamp.date(2026, 10, 31) + duration.value(43200, 's'), 'max': {"hp":25,"joy":30}, 'current': {"hp":35,"hunger":-40,"joy":30}} :
        id == 'd1-bath' ? {'at': timestamp.date(2026, 10, 31) + duration.value(43200, 's'), 'max': {"hp":30}, 'current': {"hp":70,"mp":20}} :
        id == 'd1-sleep' ? {'at': timestamp.date(2026, 11, 1) + duration.value(0, 's'), 'max': {"hp":50,"mp":40}, 'current': {"hp":100,"mp":80}} :
        id == 'd2-view' ? {'at': timestamp.date(2026, 11, 1) + duration.value(10800, 's'), 'max': {"mp":80,"joy":60}, 'current': {"mp":90,"joy":60}} :
        id == 'd2-snack' ? {'at': timestamp.date(2026, 11, 1) + duration.value(18000, 's'), 'max': {"hp":25,"joy":40}, 'current': {"hp":40,"hunger":-35,"joy":40}} :
        id == 'd2-rest' ? {'at': timestamp.date(2026, 11, 1) + duration.value(32400, 's'), 'max': {"mp":60}, 'current': {"mp":120}} :
        id == 'd2-meal' ? {'at': timestamp.date(2026, 11, 1) + duration.value(43200, 's'), 'max': {"hp":50,"joy":60}, 'current': {"hp":80,"hunger":-50,"joy":60}} :
        id == 'd2-bath' ? {'at': timestamp.date(2026, 11, 1) + duration.value(43200, 's'), 'max': {"hp":100,"mp":20}, 'current': {"hp":180,"mp":50}} :
        id == 'd2-sleep' ? {'at': timestamp.date(2026, 11, 2) + duration.value(0, 's'), 'max': {"hp":150,"mp":100}, 'current': {"hp":250,"mp":180}} :
        id == 'd3-meal' ? {'at': timestamp.date(2026, 11, 2) + duration.value(0, 's'), 'max': {"hp":25,"joy":80}, 'current': {"hp":60,"hunger":-50,"joy":80}} :
        id == 'd3-rest' ? {'at': timestamp.date(2026, 11, 2) + duration.value(0, 's'), 'max': {"mp":100,"joy":40}, 'current': {"mp":200,"joy":40}} :
        {'at':timestamp.date(9999,1,1),'max':{},'current':{}};
    }
    function questTable() {
      return {'q1-0': timestamp.date(2026, 10, 31) + duration.value(18420, 's'),
        'q1-1': timestamp.date(2026, 10, 31) + duration.value(21600, 's'),
        'q1-2': timestamp.date(2026, 10, 31) + duration.value(28800, 's'),
        'q2-0': timestamp.date(2026, 11, 1) + duration.value(7440, 's'),
        'q2-1': timestamp.date(2026, 11, 1) + duration.value(15480, 's'),
        'q2-2': timestamp.date(2026, 11, 1) + duration.value(19740, 's'),
        'q2-3': timestamp.date(2026, 11, 1) + duration.value(26040, 's'),
        'q3-0': timestamp.date(2026, 11, 2) + duration.value(0, 's'),
        'q3-1': timestamp.date(2026, 11, 2) + duration.value(10800, 's'),
        'q3-2': timestamp.date(2026, 11, 2) + duration.value(21600, 's')};
    }
    function nightTable() { return {'2026-10-31': timestamp.date(2026, 10, 31) + duration.value(43200, 's'),
        '2026-11-01': timestamp.date(2026, 11, 1) + duration.value(43200, 's'),
        '2026-11-02': timestamp.date(2026, 11, 2) + duration.value(21600, 's')}; }
    function clamp(v, max) { return v < 0 ? 0 : (v > max ? max : v); }
    function rewardPair(before, after, maxGain, recovery) {
      return after == [clamp(before[0] + recovery, before[1] + maxGain), before[1] + maxGain]
        && after[0] is int && after[1] is int && after[1] > 0 && after[1] <= 10000;
    }
    function rewardPlayer(before, after, effect) {
      let max = effect.max;
      let recovery = effect.current;
      return after.keys().hasAll(['hp','mp','hunger','joy']) && after.keys().hasOnly(['hp','mp','hunger','joy'])
        && rewardPair(before.hp, after.hp, max.get('hp',0), recovery.get('hp',0))
        && rewardPair(before.mp, after.mp, max.get('mp',0), recovery.get('mp',0))
        && rewardPair(before.hunger, after.hunger, max.get('hunger',0), recovery.get('hunger',0))
        && rewardPair(before.joy, after.joy, max.get('joy',0), recovery.get('joy',0));
    }
    function validEvent(before, after, op) {
      let effect = eventReward(op.get('id',''));
      return op.keys().hasOnly(['kind','id','actor']) && op.id is string && op.id in ["d1-rest","d1-meal","d1-bath","d1-sleep","d2-view","d2-snack","d2-rest","d2-meal","d2-bath","d2-sleep","d3-meal","d3-rest"]
        && request.time >= effect.at && !(op.id in before.done)
        && after.done == before.done.concat([op.id]) && after.questClears == before.questClears && after.logs == before.logs
        && rewardPlayer(before.players.groom, after.players.groom, effect)
        && rewardPlayer(before.players.bride, after.players.bride, effect);
    }
    function validQuest(before, after, op) {
      return op.keys().hasOnly(['kind','id','actor']) && op.id is string && questTable().keys().hasAny([op.id])
        && request.time >= questTable()[op.id] && !(op.id in before.questClears)
        && after.questClears.diff(before.questClears).affectedKeys().hasOnly([op.id])
        && after.questClears[op.id] == request.time
        && after.players == before.players && after.done == before.done && after.logs == before.logs;
    }
    function sameMax(before, after) {
      return after.hp[1] == before.hp[1] && after.mp[1] == before.mp[1]
        && after.hunger[1] == before.hunger[1] && after.joy[1] == before.joy[1];
    }
    function validStatus(before, after, op) {
      return op.keys().hasOnly(['kind','date','player','actor']) && op.player == owner()
        && op.date is string && nightTable().keys().hasAny([op.date]) && request.time >= nightTable()[op.date]
        && after.done == before.done && after.questClears == before.questClears
        && after.players[other()] == before.players[other()] && player(after.players[owner()]) && sameMax(before.players[owner()], after.players[owner()])
        && after.logs.diff(before.logs).affectedKeys().hasOnly([op.date + ':' + owner()])
        && after.logs[op.date + ':' + owner()] == {'hp':after.players[owner()].hp[0], 'mp':after.players[owner()].mp[0], 'hunger':after.players[owner()].hunger[0], 'joy':after.players[owner()].joy[0]};
    }
    match /couples/wedding-2026 {
      allow get: if allowed();
      allow list, delete: if false;
      allow create: if allowed() && envelope(request.resource.data)
        && request.resource.data.revision == 0 && request.resource.data.players == {"bride":{"hp":[30,100],"mp":[20,80],"hunger":[40,100],"joy":[100,100]},"groom":{"hp":[40,100],"mp":[30,80],"hunger":[40,100],"joy":[100,100]}}
        && request.resource.data.done == [] && request.resource.data.questClears == {} && request.resource.data.logs == {}
        && request.resource.data.lastOperation == {'kind':'init','actor':request.auth.uid};
      allow update: if allowed() && envelope(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && ((request.resource.data.lastOperation.kind == 'event' && validEvent(resource.data, request.resource.data, request.resource.data.lastOperation))
         || (request.resource.data.lastOperation.kind == 'quest' && validQuest(resource.data, request.resource.data, request.resource.data.lastOperation))
         || (request.resource.data.lastOperation.kind == 'status' && validStatus(resource.data, request.resource.data, request.resource.data.lastOperation)));
    }
    match /{document=**} { allow read, write: if false; }
  }
}
