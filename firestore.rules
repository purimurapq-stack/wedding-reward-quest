        id == 'd2-snack' ? (request.time >= timestamp.date(2026, 11, 1) + duration.value(18000, 's') && after.players == {"groom":{"hp":[clamp(before.players.groom.hp[0] + (40), before.players.groom.hp[1] + 25), before.players.groom.hp[1] + 25],"mp":before.players.groom.mp,"hunger":[clamp(before.players.groom.hunger[0] + (-35), before.players.groom.hunger[1] + 0), before.players.groom.hunger[1] + 0],"joy":[clamp(before.players.groom.joy[0] + (40), before.players.groom.joy[1] + 40), before.players.groom.joy[1] + 40]},"bride":{"hp":[clamp(before.players.bride.hp[0] + (40), before.players.bride.hp[1] + 25), before.players.bride.hp[1] + 25],"mp":before.players.bride.mp,"hunger":[clamp(before.players.bride.hunger[0] + (-35), before.players.bride.hunger[1] + 0), before.players.bride.hunger[1] + 0],"joy":[clamp(before.players.bride.joy[0] + (40), before.players.bride.joy[1] + 40), before.players.bride.joy[1] + 40]}}) :
        id == 'd2-rest' ? (request.time >= timestamp.date(2026, 11, 1) + duration.value(32400, 's') && after.players == {"groom":{"hp":before.players.groom.hp,"mp":[clamp(before.players.groom.mp[0] + (120), before.players.groom.mp[1] + 60), before.players.groom.mp[1] + 60],"hunger":before.players.groom.hunger,"joy":before.players.groom.joy},"bride":{"hp":before.players.bride.hp,"mp":[clamp(before.players.bride.mp[0] + (120), before.players.bride.mp[1] + 60), before.players.bride.mp[1] + 60],"hunger":before.players.bride.hunger,"joy":before.players.bride.joy}}) :
        id == 'd2-meal' ? (request.time >= timestamp.date(2026, 11, 1) + duration.value(43200, 's') && after.players == {"groom":{"hp":[clamp(before.players.groom.hp[0] + (80), before.players.groom.hp[1] + 50), before.players.groom.hp[1] + 50],"mp":before.players.groom.mp,"hunger":[clamp(before.players.groom.hunger[0] + (-50), before.players.groom.hunger[1] + 0), before.players.groom.hunger[1] + 0],"joy":[clamp(before.players.groom.joy[0] + (60), before.players.groom.joy[1] + 60), before.players.groom.joy[1] + 60]},"bride":{"hp":[clamp(before.players.bride.hp[0] + (80), before.players.bride.hp[1] + 50), before.players.bride.hp[1] + 50],"mp":before.players.bride.mp,"hunger":[clamp(before.players.bride.hunger[0] + (-50), before.players.bride.hunger[1] + 0), before.players.bride.hunger[1] + 0],"joy":[clamp(before.players.bride.joy[0] + (60), before.players.bride.joy[1] + 60), before.players.bride.joy[1] + 60]}}) :
        id == 'd2-bath' ? (request.time >= timestamp.date(2026, 11, 1) + duration.value(43200, 's') && after.players == {"groom":{"hp":[clamp(before.players.groom.hp[0] + (180), before.players.groom.hp[1] + 100), before.players.groom.hp[1] + 100],"mp":[clamp(before.players.groom.mp[0] + (50), before.players.groom.mp[1] + 20), before.players.groom.mp[1] + 20],"hunger":before.players.groom.hunger,"joy":before.players.groom.joy},"bride":{"hp":[clamp(before.players.bride.hp[0] + (180), before.players.bride.hp[1] + 100), before.players.bride.hp[1] + 100],"mp":[clamp(before.players.bride.mp[0] + (50), before.players.bride.mp[1] + 20), before.players.bride.mp[1] + 20],"hunger":before.players.bride.hunger,"joy":before.players.bride.joy}}) :
        id == 'd2-sleep' ? (request.time >= timestamp.date(2026, 11, 2) + duration.value(0, 's') && after.players == {"groom":{"hp":[clamp(before.players.groom.hp[0] + (250), before.players.groom.hp[1] + 150), before.players.groom.hp[1] + 150],"mp":[clamp(before.players.groom.mp[0] + (180), before.players.groom.mp[1] + 100), before.players.groom.mp[1] + 100],"hunger":before.players.groom.hunger,"joy":before.players.groom.joy},"bride":{"hp":[clamp(before.players.bride.hp[0] + (250), before.players.bride.hp[1] + 150), before.players.bride.hp[1] + 150],"mp":[clamp(before.players.bride.mp[0] + (180), before.players.bride.mp[1] + 100), before.players.bride.mp[1] + 100],"hunger":before.players.bride.hunger,"joy":before.players.bride.joy}}) : false) :
        id.matches('^d3-.*') ? (id == 'd3-meal' ? (request.time >= timestamp.date(2026, 11, 2) + duration.value(0, 's') && after.players == {"groom":{"hp":[clamp(before.players.groom.hp[0] + (60), before.players.groom.hp[1] + 25), before.players.groom.hp[1] + 25],"mp":before.players.groom.mp,"hunger":[clamp(before.players.groom.hunger[0] + (-50), before.players.groom.hunger[1] + 0), before.players.groom.hunger[1] + 0],"joy":[clamp(before.players.groom.joy[0] + (80), before.players.groom.joy[1] + 80), before.players.groom.joy[1] + 80]},"bride":{"hp":[clamp(before.players.bride.hp[0] + (60), before.players.bride.hp[1] + 25), before.players.bride.hp[1] + 25],"mp":before.players.bride.mp,"hunger":[clamp(before.players.bride.hunger[0] + (-50), before.players.bride.hunger[1] + 0), before.players.bride.hunger[1] + 0],"joy":[clamp(before.players.bride.joy[0] + (80), before.players.bride.joy[1] + 80), before.players.bride.joy[1] + 80]}}) :
        id == 'd3-rest' ? (request.time >= timestamp.date(2026, 11, 2) + duration.value(0, 's') && after.players == {"groom":{"hp":before.players.groom.hp,"mp":[clamp(before.players.groom.mp[0] + (200), before.players.groom.mp[1] + 100), before.players.groom.mp[1] + 100],"hunger":before.players.groom.hunger,"joy":[clamp(before.players.groom.joy[0] + (40), before.players.groom.joy[1] + 40), before.players.groom.joy[1] + 40]},"bride":{"hp":before.players.bride.hp,"mp":[clamp(before.players.bride.mp[0] + (200), before.players.bride.mp[1] + 100), before.players.bride.mp[1] + 100],"hunger":before.players.bride.hunger,"joy":[clamp(before.players.bride.joy[0] + (40), before.players.bride.joy[1] + 40), before.players.bride.joy[1] + 40]}}) : false) :
        false;
    }
    function questTable() {
      return {'q1-0': timestamp.date(2026, 10, 31) + duration.value(18420, 's'),
        'q1-1': timestamp.date(2026, 10, 31) + duration.value(21600, 's'),
        'q1-2': timestamp.date(2026, 10, 31) + duration.value(28800, 's'),
        'q2-0': timestamp.date(2026, 11, 1) + duration.value(7440, 's'),
        'q2-1': timestamp.date(2026, 11, 1) + duration.value(15480, 's'),
        'q2-2': timestamp.date(2026, 11, 1) + duration.value(19740, 's'),
        'q2-3': timestamp.date(2026, 11, 1) + duration.value(26040, 's'),
        'q3-0': timestamp.date(2026, 11, 2) + duration.value(0, 's'),
        'q3-1': timestamp.date(2026, 11, 2) + duration.value(10800, 's'),
        'q3-2': timestamp.date(2026, 11, 2) + duration.value(21600, 's')};
    }
    function nightTable() { return {'2026-10-31': timestamp.date(2026, 10, 31) + duration.value(43200, 's'),
