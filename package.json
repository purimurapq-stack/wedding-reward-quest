{
  "name": "wedding-reward-quest",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node tests/domain.test.js && node tests/storage.test.js && node tests/firebase-client.test.js && node tests/rules-source.test.js && node tests/ui-smoke.test.js && node tests/actions.test.js",
    "preview:html": "node scripts/preview.mjs",
    "rules:generate": "node scripts/firestore-rules.mjs",
    "test:rules": "firebase emulators:exec --project demo-wedding-reward-quest --only firestore \"node --test --test-concurrency=1 tests/firebase/firestore.rules.test.mjs\"",
    "release:prepare": "node scripts/release.mjs prepare"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "firebase": "11.10.0",
    "firebase-tools": "14.12.0"
  }
}
